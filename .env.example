# Next.js API Revalidation Secret
# This secret is used to authenticate revalidation requests from WordPress
REVALIDATION_SECRET=your-secret-token-here

# WordPress API URL
NEXT_PUBLIC_SC_API_URL=http://your-wordpress-site.com/wp-json/wp/v2/
# Absolute origin used for hreflang and canonical tags.
NEXT_PUBLIC_SITE_URL=https://www.sczg.unizg.hr

# Shared with the WordPress banner-stats snippet (studentski-centar-admin-react
# docs/banner-stats-wordpress-snippet.php). Leave unset locally: without it,
# banner views/clicks/closes are accepted and dropped instead of counted.
BANNER_STATS_SECRET=
